{
  "name": "coconet",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "api",
    "chaincodes/*",
    "contracts"
  ],
  "scripts": {
    "dev": "npm run dev --workspace=api",
    "build": "npm run build --workspace=api",
    "test": "npm run test --workspace=api",
    "test:watch": "npm run test:watch --workspace=api",
    "typecheck": "npm run typecheck --workspace=api",
    "lint": "eslint . --ext .ts",
    "seed": "npm run seed --workspace=@coconet/api",
    "demo": "tsx scripts/demo.ts",
    "demo:reset": "bash scripts/demo-reset.sh"
  },
  "devDependencies": {
    "@typescript-eslint/eslint-plugin": "^7.0.0",
    "@typescript-eslint/parser": "^7.0.0",
    "eslint": "^8.57.0",
    "typescript": "^5.4.5"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
