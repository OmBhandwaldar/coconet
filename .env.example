# ─── Server ───────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=3000
LOG_LEVEL=info

# ─── MongoDB ──────────────────────────────────────────────────────────────────
MONGO_URI=mongodb://coconetadmin:coconetsecret@localhost:27017/coconetdb?authSource=admin

# ─── MinIO ────────────────────────────────────────────────────────────────────
MINIO_ENDPOINT=localhost
MINIO_PORT=9000
MINIO_ACCESS_KEY=coconetadmin
MINIO_SECRET_KEY=coconetsecret123
MINIO_BUCKET_DOCUMENTS=trade-documents
MINIO_USE_SSL=false

# ─── Hyperledger Fabric ───────────────────────────────────────────────────────
FABRIC_CHANNEL_NAME=buyer-supplier-channel
FABRIC_CHAINCODE_ONBOARDING=onboarding-cc
FABRIC_CHAINCODE_TRADE_DOC=trade-doc-cc
FABRIC_CHAINCODE_FINANCE=finance-cc
FABRIC_CHAINCODE_PROVENANCE=provenance-cc
FABRIC_CHAINCODE_DISPUTE=dispute-cc
FABRIC_CHAINCODE_AUDIT=audit-cc
FABRIC_GATEWAY_PEER_ENDPOINT=localhost:10051
FABRIC_GATEWAY_PEER_HOST_ALIAS=peer0.platform.coconet.local
FABRIC_CRYPTO_PATH=./fabric-network/crypto-config
FABRIC_MSP_ID=PlatformMSP
FABRIC_CERT_PATH=./fabric-network/crypto-config/peerOrganizations/platform.coconet.local/users/Admin@platform.coconet.local/msp/signcerts/Admin@platform.coconet.local-cert.pem
FABRIC_KEY_DIR_PATH=./fabric-network/crypto-config/peerOrganizations/platform.coconet.local/users/Admin@platform.coconet.local/msp/keystore
FABRIC_TLS_CERT_PATH=./fabric-network/crypto-config/peerOrganizations/platform.coconet.local/peers/peer0.platform.coconet.local/tls/ca.crt

# ─── Polygon / EVM ────────────────────────────────────────────────────────────
POLYGON_RPC_URL=http://localhost:8545
POLYGON_CHAIN_ID=31337
POLYGON_PRIVATE_KEY=0xac0974bec39a17e36ba4a6b4d238ff944bacb478cbed5efcae784d7bf4f2ff80
ESCROW_FACTORY_ADDRESS=
ESCROW_VAULT_ADDRESS=
RELEASE_CONDITION_EVALUATOR_ADDRESS=
FUNDING_MANAGER_ADDRESS=

# ─── Auth (Block 3) ───────────────────────────────────────────────────────────
JWT_SECRET=change-me-in-production
JWT_EXPIRES_IN=8h

# User directory. REQUIRED in production — without it the API refuses to start
# rather than serve traffic on the development seed (rajesh/priya/suresh/
# kavitha/amit/nandita/platform/auditor, secret '<username>-dev-secret').
# Shape: [{"username","displayName","orgId","orgType","orgKey","walletUser",
#          "role","secretHash"}]  with secretHash = 'salt:scrypt-hex'.
# AUTH_USERS=

# ─── HTTP hardening (Block 2) ─────────────────────────────────────────────────
# Comma-separated allowlist. Must be set explicitly in production.
CORS_ORIGINS=http://localhost:3001
JSON_BODY_LIMIT=1mb
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=250
SHUTDOWN_TIMEOUT_MS=10000

# ─── Secrets ──────────────────────────────────────────────────────────────────
# Any secret may instead be supplied as a file path via <NAME>_FILE, which takes
# precedence — this is how Docker and Kubernetes mount secrets. Production
# refuses publicly known development values such as the Hardhat key above.

# ─── Bridge durability (Block 6) ──────────────────────────────────────────────
# The bridge keeps its checkpoint, inbox, dead letters and lease in MongoDB
# (MONGO_URI above). Without a durable store a failed cross-chain write is lost
# silently, so the bridge refuses to start rather than running without one.
BRIDGE_LEASE_TTL_MS=30000
BRIDGE_RETRY_INTERVAL_MS=30000
BRIDGE_MAX_ATTEMPTS=5
# Run the bridge inside the API. Set false in production and run `npm run worker`
# instead: the bridge is a singleton, the API is horizontally scaled. Several
# workers may run — the lease means one processes and the rest stand by.
BRIDGE_IN_API=true
# Last resort for a dev box with no Mongo. NOT durable: a restart loses the
# checkpoint and every pending delivery. Refused in production.
BRIDGE_ALLOW_MEMORY_STORE=false
